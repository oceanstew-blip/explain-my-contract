# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REQUEST_TIMEOUT_MS=90000
ANALYSIS_RATE_LIMIT_MAX=5
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_HMAC_SECRET=
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET=
TURNSTILE_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_TOKEN_SECRET=
RESEND_API_KEY=
REPORT_LINK_TOKEN_SECRET=

# Public service location used only by server-side clients today.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Stripe Checkout stays unavailable until the paid report is implemented and tested.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_PRICE_ID_SHORT=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_EXTENDED=
STRIPE_PRICE_ID_LONG=
LOCAL_FULL_REPORT_PREVIEW=false
APP_BASE_URL=http://localhost:3000

# Transactional report summaries stay off until the sending domain is verified.
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_FROM=Explain My Contract Now <reports@tamistewartconsults.com>
REPORT_EMAIL_REPLY_TO=explainmycontractnow@gmail.com
